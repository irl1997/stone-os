# Build parameters shared by scripts/build-local.sh and the GitHub workflows.
# Nothing here is a secret. The GitHub owner is never written here: workflows use
# ${GITHUB_REPOSITORY_OWNER}, local builds use the --owner argument.

IMAGE_NAME=stone-os

# Bazzite with Steam Game Mode (AMD), Fedora 44 stable stream. The build resolves this tag to
# a digest and records it in the image (label + /usr/lib/stone-release). To rebuild exactly
# an earlier image, set BASE_DIGEST to the digest recorded in that image.
BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck
BASE_TAG=stable-44
BASE_DIGEST=

# Installer builder (bootc-image-builder). Its digest is recorded in the installer build log.
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest

# ISO split size for GitHub Releases (each release file must stay under 2 GiB).
ISO_PART_SIZE=1900M
