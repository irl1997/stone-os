<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>STONE MACHINE</vendor>
  <!-- Game Mode has no password dialog, so the person at the console (active local
       session) is allowed directly. Remote or inactive sessions are refused. -->
  <action id="org.stonemachine.performance.change">
    <description>Cambiar el perfil de rendimiento de STONE MACHINE</description>
    <message>Cambiar el perfil de rendimiento requiere estar frente a la consola</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="org.stonemachine.performance.tune">
    <description>Probar ajustes avanzados de GPU en STONE MACHINE</description>
    <message>Probar ajustes avanzados requiere estar frente a la consola</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
