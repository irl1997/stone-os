[Unit]
Description=STONE Home: register the STONE shortcut and startup movie in Steam
# Pulled in and ordered before the Game Mode session by
# gamescope-session-plus@.service.d/10-stone-home.conf (any session variant).

[Service]
Type=oneshot
ExecStart=/usr/bin/stone-home-session register
TimeoutStartSec=30
# Never block the console session: a failure here only means Steam's Home is shown.
SuccessExitStatus=0 1 2
